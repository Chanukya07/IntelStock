# IntelStock Configuration

# LLM Configuration
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
LLM_MODEL=openai/gpt-3.5-turbo

# Database Configuration
DATABASE_URL=sqlite:///intelstock.db
# For PostgreSQL: postgresql://user:password@localhost:5432/intelstock

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Background Tasks
BACKGROUND_TASK_INTERVAL=900  # 15 minutes
ENABLE_BACKGROUND_TASKS=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Feature Flags
ENABLE_ALERTS=true
ENABLE_REPORTS=true
ENABLE_ANALYTICS=true
ENABLE_RAG=true

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
SECRET_KEY=your-secret-key-here

# Cache Configuration
CACHE_TTL=300
ENABLE_CACHE=true

# Market Data
MARKET_DATA_REFRESH_INTERVAL=60
ENABLE_LIVE_QUOTES=true

# RAG Configuration
RAG_VECTORSTORE_PATH=vectorstore
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# Alert Configuration
MAX_ALERTS_PER_USER=50
ALERT_CHECK_INTERVAL=60
