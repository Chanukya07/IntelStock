# IntelStock configuration
#
# Every variable below is read by real code; the file name of the reader is
# noted so a value that "does nothing" is easy to spot. Copy to .env and edit.
# The app boots with none of these set — all of them have defaults except
# OPENROUTER_API_KEY (LLM features degrade without it) and CRON_SECRET
# (the /api/v1/cron/* endpoints fail closed with 503 without it).

# --- LLM (backend/config.py) ---
# Get a key at https://openrouter.ai. Without it, sentiment falls back to
# keyword scoring and chat/insights return a "no API key" message.
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Database (backend/database/session.py) ---
# postgres:// and postgresql:// URLs are normalised to postgresql+psycopg2://.
DATABASE_URL=sqlite:///./intelstock.db
# For PostgreSQL: postgresql://user:password@localhost:5432/intelstock
# Pool settings apply to non-SQLite URLs only.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Scheduling (backend/main.py, backend/api/cron_routes.py) ---
# Set ENABLE_SCHEDULER=false when an external scheduler drives /api/v1/cron/*,
# so the jobs do not run twice.
ENABLE_SCHEDULER=true
# Shared bearer token for /api/v1/cron/*. Must match the CRON_SECRET used by
# the caller (e.g. the GitHub Actions workflow in .github/workflows).
CRON_SECRET=

# --- Frontend -> backend wiring (frontend/api_config.py) ---
# API root, no trailing slash and no /api/v1 suffix.
INTELSTOCK_API_BASE=http://127.0.0.1:8000
INTELSTOCK_REQUEST_TIMEOUT=15
INTELSTOCK_REPORT_TIMEOUT=60

# --- Ports (start.sh; PORT is supplied by the host on Render) ---
BACKEND_PORT=8000
PORT=8501
# Passed straight to `uvicorn --log-level` by start.sh.
UVICORN_LOG_LEVEL=info

# --- Set by render.yaml and docker-compose.yml ---
# NOTE: no Python code reads either of these yet. LOG_LEVEL is ignored by
# backend/logging_config.py (which is hardcoded to DEBUG) and RAG_ENABLED is
# ignored by backend/rag/*. They are kept here only because the deployment
# files pass them; setting them today changes nothing.
LOG_LEVEL=INFO
RAG_ENABLED=true
